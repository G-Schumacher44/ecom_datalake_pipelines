# =============================================================================
# GCP Configuration (commented by default)
# =============================================================================
# GOOGLE_CLOUD_PROJECT=acme-analytics
# BQ_LOCATION=US
# BQ_LOAD_ENABLED=false
# GOLD_PIPELINE_ENABLED=false
# DBT_BIGQUERY_KEYFILE=
# DBT_BQ_METHOD=oauth
# USE_SA_AUTH=false
# CLOUDSDK_CONFIG_PATH=~/.config/gcloud
# GCP_SA_KEY_PATH=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/.gcp/sa.json
# METRICS_BUCKET=
# LOGS_BUCKET=
# REPORTS_BUCKET=
# REPORTS_BASE_PATH=

# =============================================================================
# Observability & Metrics (src/observability/)
# =============================================================================
# NOTE: Primary configuration is in config/config.yml
# Set these environment variables ONLY to override config.yml values
#
# Environment: local (default), dev, or prod
# - local: Writes to ./data/metrics/ and ./data/logs/
# - dev/prod: Writes to gs://{METRICS_BUCKET}/pipeline_metrics/{run_id}/...
# PIPELINE_ENV=local
# OBSERVABILITY_ENV=

# GCS buckets for metrics and logs (only used when PIPELINE_ENV=dev or prod)
# METRICS_BUCKET=data-reporting
# LOGS_BUCKET=ecom-datalake-logs

# =============================================================================
# dbt Path Overrides (optional - defaults in dbt_project.yml)
# =============================================================================
# Override Bronze/Silver paths if different from defaults
# BRONZE_BASE_PATH=samples/bronze
# SILVER_BASE_PATH=data/silver/base
# SILVER_QUARANTINE_PATH=data/silver/base/quarantine
# SILVER_EXPORT_BASE_PATH=gs://acme-analytics-silver/data/silver/base
# SILVER_ENRICHED_PATH=data/silver/enriched
# SILVER_LOCAL_BASE_PATH=/opt/airflow/data/silver/base
# SILVER_ENRICHED_LOCAL_PATH=/opt/airflow/data/silver/enriched
# SILVER_GCS_TARGET=gs://your-silver-bucket/silver/base
# SILVER_ENRICHED_GCS_TARGET=gs://your-silver-bucket/silver/enriched

# =============================================================================
# Data Paths (local defaults)
# =============================================================================
# BRONZE_BASE_PATH=samples/bronze
# SILVER_BASE_PATH=data/silver/base
# SILVER_QUARANTINE_PATH=data/silver/base/quarantine
# SILVER_ENRICHED_PATH=data/silver/enriched
# SILVER_LOCAL_BASE_PATH=/opt/airflow/data/silver/base
# SILVER_ENRICHED_LOCAL_PATH=/opt/airflow/data/silver/enriched

# =============================================================================
# Silver FK Enforcement
# =============================================================================
# When true, enforce customer FK validity in silver (orders, shopping_carts).
# If unset, defaults by PIPELINE_ENV: prod=true, local/dev=false.
# STRICT_FK=false

# Base Silver partition window (days back from run date)
# BASE_SILVER_LOOKBACK_DAYS=0
# BRONZE_VALIDATION_LOOKBACK_DAYS=0
# SILVER_VALIDATION_LOOKBACK_DAYS=0


# =============================================================================
# Silver Profiling
# =============================================================================
# When true, generate a lightweight Silver profile report alongside validation.
# SILVER_PROFILE_ENABLED=false
# SILVER_PROFILE_REPORT=docs/validation_reports/SILVER_PROFILE.md

# =============================================================================
# Airflow Configuration
# =============================================================================
AIRFLOW_UID=50000
# Airflow admin bootstrap (docker-compose airflow-init)
# AIRFLOW_USERNAME=airflow
# AIRFLOW_PASSWORD=airflow
# AIRFLOW_EMAIL=airflow@example.com
# AIRFLOW_FIRSTNAME=Airflow
# AIRFLOW_LASTNAME=Admin
# AIRFLOW__WEBSERVER__SECRET_KEY=change-me-to-a-long-random-string
# AIRFLOW__CORE__FERNET_KEY=

# =============================================================================
# Bronze QA Configuration
# =============================================================================
# If true, Bronze QA requires gcsfs when using gs:// paths.
# Set to false to skip Bronze QA instead of failing when gcsfs is missing.
# BRONZE_QA_REQUIRED=true
# If true, Bronze QA exits non-zero when missing manifests or empty partitions are found.
# BRONZE_QA_FAIL=false
# DBT_DUCKDB_PATH=./dbt_duckdb/target/ecom.duckdb
