#!/usr/bin/env bash
# Direnv: load local environment overrides if .env exists.

# if [ -f .env ]; then
#   dotenv
# fi

# ============================================================================
# Airflow User Configuration
# ============================================================================
# AIRFLOW_USERNAME=airflow
# AIRFLOW_PASSWORD=airflow
# AIRFLOW_EMAIL=airflow@example.com
# AIRFLOW_FIRSTNAME=Airflow
# AIRFLOW_LASTNAME=Admin
# AIRFLOW_UID=50000
# AIRFLOW__WEBSERVER__SECRET_KEY=change-me-to-a-long-random-string
# AIRFLOW__CORE__FERNET_KEY=

# ============================================================================
# Pipeline Environment
# ============================================================================
# Environment: local, dev, or prod
# PIPELINE_ENV=local
# OBSERVABILITY_ENV=local
# ECOM_CONFIG_PATH=/opt/airflow/config/config.yml
# ECOM_SPEC_PATH=/opt/airflow/config/specs

# ----------------------------------------------------------------------------
# Presets (uncomment to use)
# ----------------------------------------------------------------------------
# Dev (GCS + ADC)
# PIPELINE_ENV=dev
# OBSERVABILITY_ENV=dev
# ECOM_SPEC_PATH=/opt/airflow/config/specs
# METRICS_BUCKET=data-reporting/pipeline_metrics
# REPORTS_BUCKET=data-reporting/validation_reports
# LOGS_BUCKET=data-reporting/pipeline_logs
# BRONZE_BASE_PATH=gs://acme-analytics-raw/ecom/raw
# SILVER_BASE_PATH=gs://acme-analytics-silver/data/silver/base
# SILVER_ENRICHED_PATH=gs://acme-analytics-silver/data/silver/enriched
# SILVER_DIMS_PATH=gs://acme-analytics-silver/data/silver/dims
# SILVER_PUBLISH_MODE=staging



# Prod (GCS + Service Account)
# PIPELINE_ENV=prod
# OBSERVABILITY_ENV=prod
# ECOM_SPEC_PATH=/opt/airflow/config/specs
# USE_SA_AUTH=true
# GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/.gcp/sa.json
# METRICS_BUCKET=data-reporting/pipeline_metrics
# LOGS_BUCKET=data-reporting/pipeline_logs
# REPORTS_BUCKET=data-reporting/validation_reports
# BRONZE_BASE_PATH=gs://acme-analytics-raw/ecom/raw
# SILVER_BASE_PATH=gs://acme-analytics-silver/data/silver/base
# SILVER_ENRICHED_PATH=gs://acme-analytics-silver/data/silver/enriched
# SILVER_DIMS_PATH=gs://acme-analytics-silver/data/silver/dims
# SILVER_PUBLISH_MODE=staging

# ============================================================================
# Docker/macOS VirtioFS Workaround Paths
# ============================================================================
# Redirect writable paths to /tmp inside container to avoid Errno 35 file locking
# These are set in docker-compose.yml but documented here for reference
# DBT_TARGET_PATH=/tmp/dbt_target
# DBT_LOG_PATH=/tmp/dbt_logs
# DBT_DUCKDB_PATH=/tmp/dbt_duckdb/ecom.duckdb
# METRICS_BASE_PATH=/tmp/metrics
# LOGS_BASE_PATH=/tmp/logs
# DBT_PARTIAL_PARSE=false

# ============================================================================
# GCP Configuration (optional - only needed for prod/dev with GCS/BigQuery)
# ============================================================================
# GOOGLE_CLOUD_PROJECT=acme-analytics
# BQ_LOCATION=US
# BQ_LOAD_ENABLED=false
# METRICS_BUCKET=data-reporting/pipeline_metrics
# LOGS_BUCKET=data-reporting/pipeline_logs
# REPORTS_BUCKET=data-reporting/validation_reports
# USE_SA_AUTH=false
# CLOUDSDK_CONFIG=~/.config/gcloud
# CLOUDSDK_CONFIG_PATH=~/.config/gcloud
# GCP_SA_KEY_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=
# SILVER_PUBLISH_MODE=staging

# ============================================================================
# Data Paths (local defaults)
# ============================================================================
# BRONZE_BASE_PATH=data/bronze
# SILVER_BASE_PATH=data/silver/base
# SILVER_QUARANTINE_PATH=data/silver/base/quarantine
# SILVER_ENRICHED_PATH=data/silver/enriched
# SILVER_DIMS_PATH=data/silver/dims
# SILVER_LOCAL_BASE_PATH=/opt/airflow/data/silver/base
# SILVER_ENRICHED_LOCAL_PATH=/opt/airflow/data/silver/enriched
# SILVER_DIMS_LOCAL_PATH=/opt/airflow/data/silver/dims
# SILVER_EXPORT_BASE_PATH=
# METRICS_BASE_PATH=data/metrics
# REPORTS_BASE_PATH=docs/validation_reports

# ============================================================================
# Feature Flags
# ============================================================================
# GOLD_PIPELINE_ENABLED=false
# BRONZE_QA_REQUIRED=true
# BRONZE_QA_FAIL=false
# STRICT_FK=false
# SILVER_PUBLISH_MODE=direct

# ============================================================================
# Quality Gate Flags
# ============================================================================
# SILVER_PROFILE_ENABLED=false
# SILVER_PROFILE_REPORT=docs/validation_reports/SILVER_PROFILE.md

# ============================================================================
# Enriched Silver Configuration
# ============================================================================
# BASE_SILVER_LOOKBACK_DAYS=0
# BRONZE_VALIDATION_LOOKBACK_DAYS=0
# SILVER_VALIDATION_LOOKBACK_DAYS=0
